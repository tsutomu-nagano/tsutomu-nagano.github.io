---
import '../styles/global.css';
import services from '../data/services.json';
import {
  siDocker,
  siFastapi,
  siGithub,
  siGooglechrome,
  siGraphql,
  siJavascript,
  siNextdotjs,
  siPostgresql,
  siPython,
  siR,
  siReact,
  siTypescript,
} from 'simple-icons';

const pageTitle = 'Tsutomu Nagano | Portfolio';

const simpleIconTags = {
  'Chrome Extension': siGooglechrome,
  Docker: siDocker,
  FastAPI: siFastapi,
  GraphQL: siGraphql,
  JavaScript: siJavascript,
  'Next.js': siNextdotjs,
  PostgreSQL: siPostgresql,
  Python: siPython,
  R: siR,
  React: siReact,
  TypeScript: siTypescript,
};

const textIconTags: Record<string, string> = {
  API: '{}',
  CLI: '$',
  Excel: 'XL',
  'Open Data': '□',
  Data: 'D',
  Shiny: 'S',
  Statistics: 'Σ',
  'Web UI': 'UI',
  'e-Stat': 'e',
};

const featuredServices = services.filter((service) => service.featured);
const supportingServices = services.filter((service) => !service.featured);
const primaryService = featuredServices[0];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Tsutomu Nagano が作成しているサービスを紹介するポートフォリオサイトです。" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Tsutomu Nagano Portfolio">
        <span class="brand-mark">TN</span>
        <span>Stat Tools</span>
      </a>
      <nav class="site-nav" aria-label="主要ナビゲーション">
        <a href="#start">使ってみる</a>
        <a href="#services">主要サービス</a>
        <a href="#ecosystem">ツール</a>
        <a href="#approach">方針</a>
      </nav>
      <a
        class="header-icon-link"
        href="https://github.com/tsutomu-nagano"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={siGithub.path} />
        </svg>
      </a>
    </header>

    <main>
      <section class="hero lp-band">
        <div class="site-shell hero-grid">
          <div>
            <p class="eyebrow">Service Portfolio</p>
            <h1>統計データを、もっと使いやすく。</h1>
            <p class="lead">
              e-Stat、Excel、地域コード、関連データ。扱いにくいデータを、探せる・つなげる・検査できる形へ整えるための実験とサービス群です。
            </p>
            <div class="hero-actions">
              <a class="button primary" href="#start">使い方を見る</a>
              <a class="button secondary" href="#ecosystem">ツールを探す</a>
            </div>
          </div>
          <aside class="hero-panel" aria-label="サービスの概要">
            <div class="panel-toolbar">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <pre><code>source: e-Stat / Excel / Region
normalize: metadata + relation
interface: API / GraphQL / Web UI
output: usable statistical data</code></pre>
            <dl class="hero-metrics">
              <div>
                <dt>{featuredServices.length}</dt>
                <dd>主要サービス</dd>
              </div>
              <div>
                <dt>{services.length}</dt>
                <dd>公開中の実験</dd>
              </div>
            </dl>
          </aside>
        </div>
      </section>

      <section class="section lp-band muted-band" id="start">
        <div class="site-shell start-grid">
          <div class="section-heading">
            <p class="eyebrow">Get started</p>
            <h2>まずは主要サービスから</h2>
            <p>
              統計表を探す、Excelを解析する、関連データをたどる。入口ごとに使うサービスを選べます。
            </p>
          </div>
          <div class="quickstart">
            <div class="quickstart-step">
              <span>1</span>
              <h3>探す</h3>
              <p>ReSUMEで統計データをメタデータから検索します。</p>
            </div>
            <div class="quickstart-step">
              <span>2</span>
              <h3>整える</h3>
              <p>minerでExcelの構造をJSON/APIとして扱える形にします。</p>
            </div>
            <div class="quickstart-step">
              <span>3</span>
              <h3>つなぐ</h3>
              <p>TUNAGUで関連する統計データをたどります。</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="services">
        <div class="site-shell">
          <div class="section-heading wide-heading">
            <p class="eyebrow">Solutions</p>
            <h2>現場のデータ利用を前に進める</h2>
            <p>
              それぞれのサービスは独立していますが、共通して「統計データを人とシステムの両方が扱いやすい状態へ近づける」ことを目指しています。
            </p>
          </div>

          <div class="featured-services" aria-label="主要サービス">
            {
              featuredServices.map((service) => (
                <article class="feature-showcase">
                <div class="feature-copy">
                  {service.logoUrl && (
                    <div class="service-logo">
                      <img src={service.logoUrl} alt={`${service.name} logo`} loading="lazy" />
                    </div>
                  )}
                  <div class="card-topline">
                    <strong>{service.focus}</strong>
                    <span>{service.status}</span>
                  </div>
                  {!service.logoUrl && <h3>{service.name}</h3>}
                  <p>{service.description}</p>
                  <ul class="feature-list" aria-label={`${service.name} の特徴`}>
                    {service.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                  {(service.liveUrl || service.repositoryUrl) && (
                    <div class="card-links">
                      {service.liveUrl && (
                        <a href={service.liveUrl} target="_blank" rel="noreferrer">
                          サイトを見る
                        </a>
                      )}
                    {
                      service.repositoryUrl && (
                        <a
                          class="icon-link"
                          href={service.repositoryUrl}
                          target="_blank"
                          rel="noreferrer"
                          aria-label={`${service.name} のGitHubリポジトリ`}
                        >
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d={siGithub.path} />
                          </svg>
                          <span class="sr-only">GitHub</span>
                        </a>
                      )
                    }
                    </div>
                  )}
                </div>
                <div class="feature-visual" aria-label={`${service.name} の仕組み`}>
                  <div class="flow-diagram" aria-hidden="true">
                    {service.diagram.map((step) => <span>{step}</span>)}
                  </div>
                  <ul class="tag-list" aria-label={`${service.name} の技術タグ`}>
                  {
                    service.tags.map((tag) => {
                      const simpleIcon = simpleIconTags[tag];
                      const textIcon = textIconTags[tag];

                      return (
                        <li>
                          {simpleIcon && (
                            <svg
                              class="tag-icon simple-icon"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                            >
                              <path d={simpleIcon.path} />
                            </svg>
                          )}
                          {!simpleIcon && textIcon && (
                            <span class="tag-icon" aria-hidden="true">{textIcon}</span>
                          )}
                          <span>{tag}</span>
                        </li>
                      );
                    })
                  }
                  </ul>
                </div>
              </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section lp-band muted-band" id="ecosystem">
        <div class="site-shell supporting-services" aria-label="その他のサービス">
          <div class="service-group-heading">
            <div>
              <p class="eyebrow">Ecosystem</p>
              <h2>周辺ツールもまとめて見る</h2>
            </div>
            <p>用途が明確な補助ツールや検証中のプロトタイプです。必要な処理に近いものから選べます。</p>
          </div>
          <div class="service-grid compact">
            {
              supportingServices.map((service) => (
                <article class="service-card service-card-compact">
                  {service.logoUrl && (
                    <div class="service-logo">
                      <img src={service.logoUrl} alt={`${service.name} logo`} loading="lazy" />
                    </div>
                  )}
                  <div class="card-topline">
                    <strong>{service.focus}</strong>
                    <span>{service.status}</span>
                  </div>
                  {!service.logoUrl && <h3>{service.name}</h3>}
                  <p>{service.description}</p>
                  <ul class="tag-list" aria-label={`${service.name} の技術タグ`}>
                    {
                      service.tags.slice(0, 3).map((tag) => {
                        const simpleIcon = simpleIconTags[tag];
                        const textIcon = textIconTags[tag];

                        return (
                          <li>
                            {simpleIcon && (
                              <svg
                                class="tag-icon simple-icon"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                              >
                                <path d={simpleIcon.path} />
                              </svg>
                            )}
                            {!simpleIcon && textIcon && (
                              <span class="tag-icon" aria-hidden="true">{textIcon}</span>
                            )}
                            <span>{tag}</span>
                          </li>
                        );
                      })
                    }
                  </ul>
                  {(service.liveUrl || service.repositoryUrl) && (
                    <div class="card-links">
                      {service.liveUrl && (
                        <a href={service.liveUrl} target="_blank" rel="noreferrer">
                          サイトを見る
                        </a>
                      )}
                      {
                        service.repositoryUrl && (
                          <a
                            class="icon-link"
                            href={service.repositoryUrl}
                            target="_blank"
                            rel="noreferrer"
                            aria-label={`${service.name} のGitHubリポジトリ`}
                          >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d={siGithub.path} />
                            </svg>
                            <span class="sr-only">GitHub</span>
                          </a>
                        )
                      }
                    </div>
                  )}
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section split site-shell" id="approach">
        <div>
          <p class="eyebrow">Approach</p>
          <h2>大切にしていること</h2>
        </div>
        <div class="approach-list">
          <p>まず小さく動くものを作り、使いながら価値を確かめること。</p>
          <p>UI の美しさだけでなく、迷わず使える導線と運用しやすい構成にすること。</p>
          <p>技術選定は目的から逆算し、軽く、速く、長く育てやすい形を選ぶこと。</p>
        </div>
      </section>

      <section class="section final-cta">
        <div class="site-shell final-cta-inner">
          <p class="eyebrow">Build with data</p>
          <h2>データを使える形にするところから始める。</h2>
          <div class="hero-actions">
            {primaryService?.liveUrl && (
              <a class="button primary" href={primaryService.liveUrl} target="_blank" rel="noreferrer">
                ReSUMEを開く
              </a>
            )}
            <a class="button secondary" href="https://github.com/tsutomu-nagano" target="_blank" rel="noreferrer">
              GitHubを見る
            </a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
