---
import '../styles/global.css';
import services from '../data/services.json';
import {
  siDocker,
  siFastapi,
  siGithub,
  siGooglechrome,
  siGraphql,
  siJavascript,
  siNextdotjs,
  siPostgresql,
  siPython,
  siR,
  siReact,
  siTypescript,
} from 'simple-icons';

const pageTitle = 'Tsutomu Nagano | Portfolio';

const simpleIconTags = {
  'Chrome Extension': siGooglechrome,
  Docker: siDocker,
  FastAPI: siFastapi,
  GraphQL: siGraphql,
  JavaScript: siJavascript,
  'Next.js': siNextdotjs,
  PostgreSQL: siPostgresql,
  Python: siPython,
  R: siR,
  React: siReact,
  TypeScript: siTypescript,
};

const textIconTags: Record<string, string> = {
  API: '{}',
  CLI: '$',
  Excel: 'XL',
  'Open Data': '□',
  Data: 'D',
  Shiny: 'S',
  Statistics: 'Σ',
  'Web UI': 'UI',
  'e-Stat': 'e',
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Tsutomu Nagano が作成しているサービスを紹介するポートフォリオサイトです。" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="site-shell">
      <section class="hero">
        <p class="eyebrow">Service Portfolio</p>
        <div class="hero-grid">
          <div>
            <h1>統計データを、もっと使いやすく。</h1>
            <p class="lead">
              探しやすく、比べやすく、活用しやすい形で、必要なデータにたどり着ける体験をつくります。
            </p>
            <div class="hero-actions">
              <a class="button primary" href="#services">サービスを見る</a>
              <a
                class="button secondary icon-button"
                href="https://github.com/tsutomu-nagano"
                aria-label="GitHub"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={siGithub.path} />
                </svg>
              </a>
            </div>
          </div>
          <aside class="profile-card" aria-label="プロフィール概要">
            <span class="avatar">TN</span>
            <h2>Tsutomu Nagano</h2>
            <p>Web / Data / AI を軸に、日常の課題を解くサービスを実装しています。</p>
          </aside>
        </div>
      </section>

      <section class="section" id="services">
        <div class="section-heading">
          <p class="eyebrow">Works in progress</p>
          <h2>作成中のサービス</h2>
          <p>
            指定した GitHub リポジトリを確認し、サービス概要・URL・技術スタック・開発背景を追加していけます。
          </p>
        </div>

        <div class="service-grid">
          {
            services.map((service) => (
              <article class="service-card">
                {service.logoUrl && (
                  <div class="service-logo">
                    <img src={service.logoUrl} alt={`${service.name} logo`} loading="lazy" />
                  </div>
                )}
                <div class="card-topline">
                  <span>{service.status}</span>
                </div>
                <h3>{service.name}</h3>
                <p>{service.description}</p>
                <ul class="tag-list" aria-label={`${service.name} の技術タグ`}>
                  {
                    service.tags.map((tag) => {
                      const simpleIcon = simpleIconTags[tag];
                      const textIcon = textIconTags[tag];

                      return (
                        <li>
                          {simpleIcon && (
                            <svg
                              class="tag-icon simple-icon"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                            >
                              <path d={simpleIcon.path} />
                            </svg>
                          )}
                          {!simpleIcon && textIcon && (
                            <span class="tag-icon" aria-hidden="true">{textIcon}</span>
                          )}
                          <span>{tag}</span>
                        </li>
                      );
                    })
                  }
                </ul>
                {(service.liveUrl || service.repositoryUrl) && (
                  <div class="card-links">
                    {service.liveUrl && (
                      <a href={service.liveUrl} target="_blank" rel="noreferrer">
                        サイトを見る
                      </a>
                    )}
                  {
                    service.repositoryUrl && (
                      <a
                        class="icon-link"
                        href={service.repositoryUrl}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={`${service.name} のGitHubリポジトリ`}
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d={siGithub.path} />
                        </svg>
                        <span class="sr-only">GitHub</span>
                      </a>
                    )
                  }
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="section split">
        <div>
          <p class="eyebrow">Approach</p>
          <h2>大切にしていること</h2>
        </div>
        <div class="approach-list">
          <p>まず小さく動くものを作り、使いながら価値を確かめること。</p>
          <p>UI の美しさだけでなく、迷わず使える導線と運用しやすい構成にすること。</p>
          <p>技術選定は目的から逆算し、軽く、速く、長く育てやすい形を選ぶこと。</p>
        </div>
      </section>
    </main>
  </body>
</html>
